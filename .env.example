PORT=3000
MONGODB_URI=mongodb://localhost:27017/chat-api
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# Firebase Admin
# Opcao 1: use GOOGLE_APPLICATION_CREDENTIALS apontando para o JSON da service account
# Opcao 2: preencha as variaveis abaixo
FIREBASE_PROJECT_ID=seu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nSUA_CHAVE\\n-----END PRIVATE KEY-----\\n"

# Socket (opcional)
# DEBUG_SOCKET=1
# SOCKET_POPULATE=0
